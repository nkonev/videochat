{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "frontend",
            "request": "launch",
            "runtimeArgs": [
                "run",
                "dev"
            ],
            "runtimeExecutable": "npm",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "type": "node",
            "cwd": "${workspaceFolder}/frontend",
            "outputCapture": "std"
        },
        {
            "name": "public",
            "request": "launch",
            "runtimeArgs": [
                "run",
                "dev"
            ],
            "runtimeExecutable": "npm",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "type": "node",
            "cwd": "${workspaceFolder}/public",
            "outputCapture": "std"
        },
        {
            "type": "jdk",
            "request": "launch",
            "name": "aaa",
            "cwd": "${workspaceFolder}/aaa",
            "mainClass": "${workspaceFolder}/aaa/src/main/java/name/nkonev/aaa/AaaApplication.java"
        },
        {
            "name": "chat",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/chat",
            "args": [
                "serve"
            ]
        },
        {
            "name": "video",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/video"
        },
        {
            "name": "storage",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/storage"
        },
        {
            "name": "event",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/event"
        },
        {
            "name": "notification",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/notification"
        },

    ]
}